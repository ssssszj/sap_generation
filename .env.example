# Required: enables real LLM calls through Qiniu's OpenAI-compatible API.
QNY_API_KEY=

# Optional: default model used by lib/llm-client.ts.
QNY_MODEL=deepseek/deepseek-v4.1-flash

# Optional: domestic endpoint by default. For overseas access, use https://api.modelink.ai.
QNY_API_BASE_URL=https://api.qnaigc.com

# Optional: set to "on", "true", or "1" to use HTTPS_PROXY/HTTP_PROXY.
QNY_PROXY_MODE=off
HTTPS_PROXY=
HTTP_PROXY=

# Optional: cap injected rubric JSON length for generate-with-revision.
# Leave empty or set to 0 to inject the full rubric.
SAP_RUBRIC_MAX_CHARS=0
