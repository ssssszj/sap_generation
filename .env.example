# Required: enables real LLM calls through OpenRouter.
OPENROUTER_API_KEY=

# Optional: default model used by lib/llm-client.ts.
OPENROUTER_MODEL=openai/gpt-4o

# Optional: set to "on", "true", or "1" to use HTTPS_PROXY/HTTP_PROXY.
OPENROUTER_PROXY_MODE=off
HTTPS_PROXY=
HTTP_PROXY=

# Optional: cap injected rubric JSON length for generate-with-revision.
# Leave empty or set to 0 to inject the full rubric.
SAP_RUBRIC_MAX_CHARS=0
