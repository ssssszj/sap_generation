# DeepSeek Harness owns the model connection and session runtime.
# The benchmark judge uses QNY_API_KEY. The application also accepts it as a
# fallback when DEEPSEEK_API_KEY is not set.
QNY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
SAPGEN_DSH_HOME=.runtime/dsh-home
SAPGEN_DSH_PROFILE=sdk
SAPGEN_DSH_PROVIDER=deepseek-official
SAPGEN_DSH_MODEL=deepseek-v4-flash
SAPGEN_DSH_REASONING_EFFORT=high
# Windows fallback: use the pinned npm runtime when the SDK wheel misses a native binding.
SAPGEN_DSH_NODE=
SAPGEN_DSH_JS=node_modules/@deepseek-ai/dsh/lib/bin.js

# Application storage.
SAPGEN_DATA_DIR=.runtime/data
SAPGEN_DATABASE=.runtime/sapgen.sqlite3
SAPGEN_HOST=127.0.0.1
SAPGEN_PORT=3000

